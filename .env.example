# Copy to `.env` in the repo root and set strong values before `npm start` or `docker compose up`.
# Never commit `.env`.

PLAYER_SESSION_JWT_SECRET=replace-with-at-least-32-random-characters
PLAYER_SESSION_ACCESS_TTL=15m
PLAYER_SESSION_REFRESH_TTL=30d

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880

REDIS_URL=redis://127.0.0.1:6379
LOBBY_IDLE_TTL_SECONDS=300

# Optional: comma-separated browser origins (e.g. http://localhost:4200)
# CORS_ORIGINS=http://localhost:4200

# API log verbosity: error | warn | log (default) | debug | verbose
# LOG_LEVEL=log
