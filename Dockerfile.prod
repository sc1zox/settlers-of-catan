FROM node:24-bookworm-slim AS builder

WORKDIR /workspace

ENV CI=true
ENV NX_DAEMON=false
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
ENV NX_WORKSPACE_DATA_DIRECTORY=node_modules/.cache/nx-workspace-data

COPY package.json package-lock.json .npmrc ./
RUN npm ci --prefer-offline --no-audit --no-fund --loglevel error

COPY . .

ENV NODE_ENV=production

RUN ./node_modules/.bin/nx run-many -t build --projects=catan-client,catan-api --configuration=production --skip-nx-cache

FROM node:24-bookworm-slim AS api

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /workspace/dist/apps/catan-api/ ./
RUN npm install --omit=dev --prefer-offline --no-audit --no-fund --loglevel error \
  && chown -R node:node /app

USER node
EXPOSE 3000

CMD ["node", "main.js"]

FROM nginx:stable-alpine AS web

ENV NGINX_LISTEN_PORT=80
ENV CATAN_API_UPSTREAM=http://api:3000

COPY deploy/nginx.prod.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /workspace/dist/apps/catan-client/browser /usr/share/nginx/html

EXPOSE 80
