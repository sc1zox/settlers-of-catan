CATAN_API_IMAGE=ghcr.io/OWNER_REPO_LOWERCASE:api
CATAN_WEB_IMAGE=ghcr.io/OWNER_REPO_LOWERCASE:web

PUBLIC_WEB_PORT=80
WEB_INTERNAL_PORT=80
API_CONTAINER_PORT=3000

REDIS_URL=redis://redis:6379

TURN_LISTEN_PORT=3478
TURN_RTC_MIN_PORT=49160
TURN_RTC_MAX_PORT=49200
TURN_RTC_UDP_RANGE_PUBLISH=49160-49200

LIVEKIT_CONFIG_HOST_PATH=./deploy/livekit.prod.yaml
LIVEKIT_PUBLISH_HTTP=7880
LIVEKIT_PUBLISH_RTC_TCP=7881
LIVEKIT_PUBLISH_UDP_PRIMARY=7882
LIVEKIT_PUBLISH_UDP_RANGE=50000-50100

LIVEKIT_HTTP_URL=http://livekit:7880

PLAYER_SESSION_JWT_SECRET=min-32-chars-strong-random-change-me
PLAYER_SESSION_ACCESS_TTL=15m
PLAYER_SESSION_REFRESH_TTL=30d

TURN_PASSWORD=changeme-strong-turn-password

LIVEKIT_API_KEY=changeme-livekit-api-key-name
LIVEKIT_API_SECRET=changeme-livekit-api-secret-lengthy
LIVEKIT_PUBLIC_URL=wss://YOUR_PUBLIC_HOST:7880
