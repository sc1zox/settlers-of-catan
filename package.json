{
  "name": "catan-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n api,web \"nx serve catan-api\" \"nx serve catan-client\"",
    "start:client": "nx serve catan-client",
    "start:api": "nx serve catan-api",
    "build": "nx run-many -t build --projects=catan-client,catan-api",
    "watch": "nx build catan-client --watch --configuration development",
    "test": "nx test catan-client",
    "lint": "nx run-many -t lint --projects=catan-client,catan-api,shared-game-field,api-interfaces --parallel",
    "format": "prettier --write \"apps/**/*.{ts,html,scss,json}\" \"libs/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,html,scss,json}\" \"libs/**/*.{ts,html,scss,json}\""
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@nestjs/common": "^11.1.20",
    "@nestjs/core": "^11.1.20",
    "@nestjs/platform-express": "^11.1.20",
    "@nestjs/platform-socket.io": "^11.1.20",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/websockets": "^11.1.20",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.184.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.2.10",
    "@angular-devkit/schematics": "^21.2.10",
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "21.6.11",
    "@nx/eslint": "^21.6.11",
    "@nx/js": "21.6.11",
    "@nx/nest": "^21.6.11",
    "@nx/node": "^21.6.11",
    "@nx/web": "21.6.11",
    "@nx/webpack": "21.6.11",
    "@nx/workspace": "21.6.11",
    "@schematics/angular": "^21.2.10",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "20.19.9",
    "@types/three": "^0.184.1",
    "angular-eslint": "21.3.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "jsdom": "^28.0.0",
    "nx": "21.6.11",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.0.8",
    "webpack-cli": "^5.1.4"
  }
}
